# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/driver_education?schema=public"

# JWT (minimum 32 characters)
JWT_SECRET="change-me-to-a-long-random-secret-at-least-32-chars"

# App URL (used in email links)
APP_URL="http://localhost:3000"

# Email (optional — logs to console when SMTP is not configured)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Driver Education <noreply@example.com>"

# Demo mode (development only — auto-logs in as demo student without sign-up)
ENABLE_DEMO_AUTO_LOGIN="false"
DEMO_STUDENT_EMAIL=""

# Required to run the destructive local seed; production always refuses
ALLOW_DESTRUCTIVE_SEED="false"
