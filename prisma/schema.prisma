// US Driver Education Platform — PostgreSQL Schema
// Production-grade design for 100k+ users

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  STUDENT
  ADMIN
}

enum ContentBlockType {
  HEADING
  PARAGRAPH
  IMAGE
  VIDEO
  CALLOUT
  CHECKLIST
  QUOTE
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  IMAGE_QUESTION
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum LessonStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ---------------------------------------------------------------------------
// Users
// ---------------------------------------------------------------------------

model User {
  id                     String    @id @default(uuid()) @db.Uuid
  email                  String    @unique @db.VarChar(320)
  passwordHash           String    @map("password") @db.VarChar(255)
  role                   UserRole  @default(STUDENT)
  firstName              String    @map("first_name") @db.VarChar(100)
  lastName               String    @map("last_name") @db.VarChar(100)
  phone                  String?   @db.VarChar(20)
  city                   String?   @db.VarChar(100)
  state                  String?   @default("CA") @db.VarChar(2)
  profilePhoto           String?   @map("profile_photo") @db.VarChar(2048)
  emailVerified          Boolean   @default(false) @map("email_verified")
  emailVerificationToken String?   @map("email_verification_token") @db.VarChar(255)
  passwordResetToken     String?   @map("password_reset_token") @db.VarChar(255)
  passwordResetExpiry    DateTime? @map("password_reset_expiry") @db.Timestamptz(3)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  progress              StudentProgress[]
  courseProgress        CourseProgress[]
  quizAttempts          QuizAttempt[]
  practiceTestAttempts  PracticeTestAttempt[]
  achievements          UserAchievement[]
  notifications         Notification[]
  studyTimeLogs         StudyTimeLog[]
  seriesProgress        SeriesProgress[]
  driveSetup            StudentDriveSetup?

  @@index([role])
  @@index([createdAt])
  @@index([emailVerificationToken])
  @@index([passwordResetToken])
  @@map("users")
}

model StudentDriveSetup {
  userId       String   @id @map("user_id") @db.Uuid
  address      String   @db.VarChar(500)
  instructorId String   @map("instructor_id") @db.VarChar(100)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_drive_setups")
}

// ---------------------------------------------------------------------------
// Course hierarchy: Course → Unit → Chapter → Lesson
// ---------------------------------------------------------------------------

model Course {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique @db.VarChar(120)
  title       String   @db.VarChar(255)
  description String   @db.Text
  regionCode  String   @map("state") @db.VarChar(10) // Region identifier: US state, country code, etc.
  thumbnail   String?  @db.VarChar(2048)
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  units          Unit[]
  practiceExams  PracticeExam[]
  courseProgress CourseProgress[]

  @@index([regionCode])
  @@index([isPublished])
  @@map("courses")
}

model Unit {
  id          String   @id @default(uuid()) @db.Uuid
  courseId    String   @map("course_id") @db.Uuid
  title       String   @db.VarChar(255)
  description String   @db.Text
  orderNumber Int      @map("order_number")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  course   Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  chapters Chapter[]

  @@unique([courseId, orderNumber])
  @@index([courseId])
  @@map("units")
}

model Chapter {
  id          String   @id @default(uuid()) @db.Uuid
  unitId      String   @map("unit_id") @db.Uuid
  title       String   @db.VarChar(255)
  description String   @db.Text
  orderNumber Int      @map("order_number")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  unit    Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@unique([unitId, orderNumber])
  @@index([unitId])
  @@map("chapters")
}

model Lesson {
  id                String       @id @default(uuid()) @db.Uuid
  chapterId         String       @map("chapter_id") @db.Uuid
  title             String       @db.VarChar(255)
  description       String       @db.Text
  estimatedDuration Int          @map("estimated_duration") // minutes
  orderNumber       Int          @map("order_number")
  status            LessonStatus @default(DRAFT)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  chapter       Chapter             @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  contentBlocks LessonContentBlock[]
  questions     QuizQuestion[]
  quiz          Quiz?
  progress      StudentProgress[]

  @@unique([chapterId, orderNumber])
  @@index([chapterId])
  @@index([status])
  @@map("lessons")
}

// ---------------------------------------------------------------------------
// Lesson content blocks (reusable structured content)
// ---------------------------------------------------------------------------

model LessonContentBlock {
  id          String           @id @default(uuid()) @db.Uuid
  lessonId    String           @map("lesson_id") @db.Uuid
  type        ContentBlockType
  content     Json             // Flexible payload per block type (text, media URLs, checklist items, etc.)
  orderNumber Int              @map("order_number")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, orderNumber])
  @@index([lessonId])
  @@map("lesson_content_blocks")
}

// ---------------------------------------------------------------------------
// Quizzes (1:1 with lessons — a lesson's question set)
// ---------------------------------------------------------------------------

model Quiz {
  id        String   @id @default(uuid()) @db.Uuid
  lessonId  String   @unique @map("lesson_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  lesson   Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  attempts QuizAttempt[]

  @@map("quizzes")
}

// ---------------------------------------------------------------------------
// Quiz questions & answers
// ---------------------------------------------------------------------------

model QuizQuestion {
  id           String             @id @default(uuid()) @db.Uuid
  lessonId     String             @map("lesson_id") @db.Uuid
  question     String             @db.Text
  explanation  String?            @db.Text
  difficulty   QuestionDifficulty @default(MEDIUM)
  category     String             @db.VarChar(100)
  questionType QuestionType       @map("question_type")
  orderNumber  Int                @default(0) @map("order_number")
  imageUrl     String?            @map("image_url") @db.VarChar(2048) // Required for IMAGE_QUESTION type
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  lesson        Lesson                 @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  answers       QuizAnswer[]
  practiceExams PracticeExamQuestion[]

  @@index([lessonId])
  @@index([category])
  @@index([difficulty])
  @@map("quiz_questions")
}

model QuizAnswer {
  id         String   @id @default(uuid()) @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  answerText String   @map("answer_text") @db.Text
  isCorrect  Boolean  @default(false) @map("is_correct")
  orderNumber Int     @default(0) @map("order_number")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("quiz_answers")
}

// ---------------------------------------------------------------------------
// Practice exams
// ---------------------------------------------------------------------------

model PracticeExam {
  id           String   @id @default(uuid()) @db.Uuid
  courseId     String?  @map("course_id") @db.Uuid // Optional link to state-specific course
  title        String   @db.VarChar(255)
  description  String   @db.Text
  passingScore Int      @map("passing_score") // Percentage 0–100
  timeLimit    Int      @map("time_limit") // Minutes
  seriesNumber Int?     @map("series_number") // 1–30 for series final exams
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  course    Course?                @relation(fields: [courseId], references: [id], onDelete: SetNull)
  questions PracticeExamQuestion[]
  attempts  PracticeTestAttempt[]

  @@index([courseId])
  @@index([seriesNumber])
  @@map("practice_exams")
}

model PracticeExamQuestion {
  id             String   @id @default(uuid()) @db.Uuid
  practiceExamId String   @map("practice_exam_id") @db.Uuid
  questionId     String   @map("question_id") @db.Uuid
  orderNumber    Int      @map("order_number")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  practiceExam PracticeExam @relation(fields: [practiceExamId], references: [id], onDelete: Cascade)
  question     QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([practiceExamId, questionId])
  @@unique([practiceExamId, orderNumber])
  @@index([questionId])
  @@map("practice_exam_questions")
}

// ---------------------------------------------------------------------------
// Student progress & attempts
// ---------------------------------------------------------------------------

model StudentProgress {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  lessonId             String    @map("lesson_id") @db.Uuid
  completionPercentage Int       @default(0) @map("completion_percentage") // 0–100
  completedAt          DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@index([userId, completedAt])
  @@map("student_progress")
}

model CourseProgress {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  courseId             String    @map("course_id") @db.Uuid
  completionPercentage Int       @default(0) @map("completion_percentage") // 0–100
  completedAt          DateTime? @map("completed_at") @db.Timestamptz(3)
  lastAccessedAt       DateTime? @map("last_accessed_at") @db.Timestamptz(3)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("course_progress")
}

model QuizAttempt {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  quizId        String   @map("quiz_id") @db.Uuid
  score         Int      // Percentage 0–100
  attemptNumber Int      @map("attempt_number")
  attemptedAt   DateTime @default(now()) @map("attempted_at") @db.Timestamptz(3)

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz    Quiz               @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers QuizAttemptAnswer[]

  @@unique([userId, quizId, attemptNumber])
  @@index([userId])
  @@index([quizId])
  @@index([userId, attemptedAt])
  @@map("quiz_attempts")
}

model QuizAttemptAnswer {
  id               String  @id @default(uuid()) @db.Uuid
  attemptId        String  @map("attempt_id") @db.Uuid
  questionId       String  @map("question_id") @db.Uuid
  selectedAnswerId String? @map("selected_answer_id") @db.Uuid
  isCorrect        Boolean @map("is_correct")

  attempt QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@map("quiz_attempt_answers")
}

model PracticeTestAttempt {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  practiceExamId String   @map("practice_exam_id") @db.Uuid
  score          Int      // Percentage 0–100
  passed         Boolean  @map("pass_fail")
  timeSpent      Int      @map("time_spent") // Seconds
  attemptedAt    DateTime @default(now()) @map("attempted_at") @db.Timestamptz(3)

  user         User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  practiceExam PracticeExam                @relation(fields: [practiceExamId], references: [id], onDelete: Cascade)
  answers      PracticeTestAttemptAnswer[]

  @@index([userId])
  @@index([practiceExamId])
  @@index([userId, attemptedAt])
  @@map("practice_test_attempts")
}

model PracticeTestAttemptAnswer {
  id               String  @id @default(uuid()) @db.Uuid
  attemptId        String  @map("attempt_id") @db.Uuid
  questionId       String  @map("question_id") @db.Uuid
  selectedAnswerId String? @map("selected_answer_id") @db.Uuid
  isCorrect        Boolean @map("is_correct")

  attempt PracticeTestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@map("practice_test_attempt_answers")
}

// ---------------------------------------------------------------------------
// Achievements
// ---------------------------------------------------------------------------

model Achievement {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @unique @db.VarChar(255)
  description String   @db.Text
  icon        String   @db.VarChar(2048) // Icon URL or asset key
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  users UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  achievementId String   @map("achievement_id") @db.Uuid
  earnedAt      DateTime @default(now()) @map("earned_at") @db.Timestamptz(3)

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
  @@map("user_achievements")
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String   @db.VarChar(255)
  message   String   @db.Text
  isRead    Boolean  @default(false) @map("read_status")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// Study time & series progress (30-hour certificate MVP)
// ---------------------------------------------------------------------------

enum StudyActivityType {
  LESSON
  EXAM
  QUIZ
  PRACTICE
}

model StudyTimeLog {
  id           String            @id @default(uuid()) @db.Uuid
  userId       String            @map("user_id") @db.Uuid
  activityType StudyActivityType @map("activity_type")
  resourceId   String?           @map("resource_id") @db.Uuid
  seconds      Int
  loggedAt     DateTime          @default(now()) @map("logged_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, loggedAt])
  @@map("study_time_logs")
}

model SeriesProgress {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  seriesNumber  Int       @map("series_number")
  lessonsDone   Boolean   @default(false) @map("lessons_done")
  examPassed    Boolean   @default(false) @map("exam_passed")
  completedAt   DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, seriesNumber])
  @@index([userId])
  @@map("series_progress")
}
